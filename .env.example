# Copy to .env.local and fill in. Never commit real keys.
ANTHROPIC_API_KEY=

# Only needed if your key is NOT scoped to a workspace (the API will say so).
# Find the ID in console.anthropic.com under Settings > Workspaces (starts with wrkspc_).
# ANTHROPIC_WORKSPACE_ID=

# Optional: where the SQLite database lives (default: ./data/building-bridges.sqlite)
# DATABASE_PATH=

# Speech-to-text for the mic button (ElevenLabs Scribe).
ELEVENLABS_API_KEY=
